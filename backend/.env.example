# Ambiente: "development" (padrão) ou "production".
# Em production a API recusa JWT_SECRET_KEY placeholder/curta (< 32 caracteres)
# e libera no CORS apenas FRONTEND_URL + CORS_ORIGINS.
APP_ENV=development

# Supabase/PostgreSQL (use o Shared Session Pooler quando necessário)
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=troque-por-uma-chave-secreta-forte
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Frontend / arquivos locais
FRONTEND_URL=http://localhost:3000
# Origens extras permitidas no CORS, separadas por vírgula (ex.: página do e-book).
# Em desenvolvimento, localhost:5500 (Live Server) já é liberado.
CORS_ORIGINS=
UPLOAD_BASE_URL=http://127.0.0.1:8000/uploads

# ---------------------------------------------------------------------------
# E-mail pós e-book (2.1.0-rc.1) — DESLIGADO por padrão.
# Nunca coloque chaves/senhas reais em arquivos versionados.
# ---------------------------------------------------------------------------
EMAIL_AUTOMATION_ENABLED=false
# "console" só registra em log (homologação sem envio). "smtp" usa o SMTP abaixo.
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
# Link do material (e-book gratuito) incluído no e-mail de entrega. Opcional.
EBOOK_DELIVERY_URL=
# Etapa comercial: só vira CTA se EMAIL_COMMERCIAL_ENABLED=true E PAID_PRODUCT_URL for uma
# URL http(s) real. Sem URL, o e-mail contém apenas entrega/agradecimento.
EMAIL_COMMERCIAL_ENABLED=false
PAID_PRODUCT_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
